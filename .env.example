# ==========================================
# Oil & Gas Sales Hub - Environment Variables
# ==========================================

# 1. MongoDB Atlas Connection
# Format: mongodb+srv://<username>:<password>@<cluster-url>/<database-name>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/oil_gas_sales_hub?retryWrites=true&w=majority

# 2. Server-side Authentication & Session Secrets
# Generate a strong 32+ character random secret for production: `openssl rand -hex 32`
JWT_SECRET=replace_with_a_secure_random_32_char_string_for_production
JWT_EXPIRES_IN=7d
COOKIE_NAME=ogsh_session

# 3. Cloudinary Document Management (Private & Public Storage)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# 4. Initial Seed Setup (Used by seed script)
INITIAL_ADMIN_EMAIL=admin@oilgashub.com
INITIAL_ADMIN_PASSWORD=AdminSecure2026!
INITIAL_SALES1_EMAIL=sales1@oilgashub.com
INITIAL_SALES1_PASSWORD=Sales1Secure2026!
INITIAL_SALES2_EMAIL=sales2@oilgashub.com
INITIAL_SALES2_PASSWORD=Sales2Secure2026!

# 5. Public Application URLs & Metadata
NEXT_PUBLIC_APP_NAME="Oil & Gas Sales Hub"
NEXT_PUBLIC_APP_URL=http://localhost:3000
